<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>viprs_acadsharp</AssemblyName>
    <RootNamespace>Viprs.ACadSharp.Native</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>false</SignAssembly>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Configurations>Debug;Release;AbiTest</Configurations>
    <!-- Upstream's own warnings, which this project does not own and cannot fix
         without a patch. AOT and trim warnings are deliberately not in here. -->
    <NoWarn>$(NoWarn);CS0618;CS0162</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <!-- One warning per site. The default collapses an assembly's trim
         warnings into a single line, which is how a count of 2 hid 16. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Load-bearing at run time, not a size tweak. CadHeader's constructor
         reaches DateTime.Now -> TimeZoneInfo -> CultureInfo, and a NativeAOT
         binary on a host with no libicu calls FailFast there. That aborts with
         SIGABRT through any try/catch, so the export cannot turn it into a
         return code. ADR 0001 records what it costs DWG code-page text. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also load-bearing. ACadSharp reaches its table entry types through
         Activator.CreateInstance (Tables/Collections/Table.cs), so without the
         root the publish succeeds and the first CadDocument throws
         MissingMethodException on AppId. CSMath and CSUtilities need no root
         of their own: upstream imports them as shared projects (.projitems),
         so their types are compiled into ACadSharp.dll. -->
    <TrimmerRootAssembly Include="ACadSharp" />
  </ItemGroup>

  <!-- The vendored ACadSharp checkout. build_acadsharp.py resolves the path
       from acadsharp/VERSION and passes it in, so the upstream version lives
       in one file rather than in this one as well. -->
  <ItemGroup Condition="'$(AcadSharpProject)' != ''">
    <ProjectReference Include="$(AcadSharpProject)" />
  </ItemGroup>


  <!-- AbiTest is Release plus the one export whose whole job is to throw, so
       the C conformance consumer can show that a managed exception comes back
       as a result code and the process keeps running. Nothing published to a
       consumer is built this way.

       It is not called "Test", which is the obvious name and the wrong one:
       the SDK turns the configuration name into a preprocessor symbol, and the
       vendored upstream source carries `#if TEST` regions that do not compile
       on their own (they use collection types the file never imports). A
       configuration name is therefore part of this project's build contract
       with a dependency, which is not somewhere I expected to find one. -->
  <PropertyGroup Condition="'$(Configuration)' == 'AbiTest'">
    <DefineConstants>$(DefineConstants);VIPRS_ACAD_TEST_EXPORTS</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- The ABI fingerprint, generated rather than assigned.

       viprs_acad_abi_fingerprint() returns the first eight bytes of the sha256
       of the published header, big-endian. A constant somebody typed would be
       right until the first time the header changed and then wrong in the only
       direction that does damage: it would keep reporting agreement while a
       consumer read a struct field four bytes from where it actually is.

       So the number comes from the file, during the build, every build. The
       generated source lands in the intermediate directory and is never
       checked in, because a checked-in generated file is a hand-assigned one
       with extra steps: it becomes the stale copy on the first build that
       skips the target. -->
  <PropertyGroup>
    <ViprsAbiHeader>$(MSBuildProjectDirectory)/../include/viprs_acadsharp.h</ViprsAbiHeader>
    <ViprsVersionFile>$(MSBuildProjectDirectory)/../VERSION</ViprsVersionFile>
  </PropertyGroup>

  <Target Name="GenerateAbiFingerprint" BeforeTargets="BeforeCompile">
    <Error
      Condition="!Exists('$(ViprsAbiHeader)')"
      Text="$(ViprsAbiHeader) is missing. The fingerprint is defined as the hash of the published header, so there is nothing to generate and nothing this library could honestly report." />

    <GetFileHash Files="$(ViprsAbiHeader)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="ViprsAbiHeaderHashRaw" />
    </GetFileHash>

    <PropertyGroup>
      <ViprsAbiHeaderSha256>$(ViprsAbiHeaderHashRaw.ToLowerInvariant())</ViprsAbiHeaderSha256>
      <ViprsAbiFingerprintRaw>$(ViprsAbiHeaderSha256.Substring(0,16))</ViprsAbiFingerprintRaw>
      <ViprsAbiFingerprintHex>$(ViprsAbiFingerprintRaw.ToUpperInvariant())</ViprsAbiFingerprintHex>
    </PropertyGroup>

    <ReadLinesFromFile File="$(ViprsVersionFile)">
      <Output TaskParameter="Lines" ItemName="ViprsVersionLine" />
    </ReadLinesFromFile>

    <!-- acadsharp/VERSION is <upstream>-viprs.<revision>, and the two halves
         answer two different questions. The artifact version names the
         archive; the upstream half is the ACadSharp release, which is what
         viprs_acad_get_capabilities_v1 is documented to report and what
         LINKINFO.json records as acadsharp_version.

         It used to report the whole string, so the call wrote the artifact
         version into a parameter the header calls "the pinned ACadSharp
         version" while the manifest beside it carried only the upstream
         half. Two frozen surfaces, one question, two answers. -->
    <PropertyGroup>
      <ViprsShimVersion>@(ViprsVersionLine)</ViprsShimVersion>
      <ViprsVersionSuffixIndex>$(ViprsShimVersion.IndexOf('-viprs.'))</ViprsVersionSuffixIndex>
    </PropertyGroup>

    <Error
      Condition="'$(ViprsVersionSuffixIndex)' == '-1'"
      Text="$(ViprsVersionFile) reads '$(ViprsShimVersion)', which is not &lt;upstream&gt;-viprs.&lt;revision&gt;. viprs_acad_get_capabilities_v1 reports the upstream half and there is no way to take it from this." />

    <PropertyGroup>
      <ViprsUpstreamVersion>$(ViprsShimVersion.Substring(0, $(ViprsVersionSuffixIndex)))</ViprsUpstreamVersion>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(IntermediateOutputPath)AbiFingerprint.g.cs"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
      Lines="// &lt;auto-generated /&gt;;// Generated from include/viprs_acadsharp.h by the GenerateAbiFingerprint target.;// Never edit this and never check it in.;namespace Viprs.Abi;{;%09internal static class AbiFingerprint;%09{;%09%09public const ulong Value = 0x$(ViprsAbiFingerprintHex)UL%3B;%09%09public const string HeaderSha256 = &quot;$(ViprsAbiHeaderSha256)&quot;%3B;%09};}" />

    <WriteLinesToFile
      File="$(IntermediateOutputPath)AcadSharpVersion.g.cs"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
      Lines="// &lt;auto-generated /&gt;;// Generated from acadsharp/VERSION by the GenerateAbiFingerprint target.;// Text is the upstream ACadSharp release, which is what the header promises;// viprs_acad_get_capabilities_v1 writes and what LINKINFO.json records.;namespace Viprs.Abi;{;%09internal static class AcadSharpVersion;%09{;%09%09public const string Text = &quot;$(ViprsUpstreamVersion)&quot;%3B;%09};}" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)AbiFingerprint.g.cs" />
      <Compile Include="$(IntermediateOutputPath)AcadSharpVersion.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)AbiFingerprint.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)AcadSharpVersion.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="RequireAcadSharpProject" BeforeTargets="BeforeBuild">
    <Error
      Condition="'$(AcadSharpProject)' == ''"
      Text="AcadSharpProject is not set. Build through acadsharp/build_acadsharp.py, which reads acadsharp/VERSION, fetches the pinned source and passes -p:AcadSharpProject." />
  </Target>

</Project>
